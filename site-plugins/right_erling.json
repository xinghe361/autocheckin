{
  "id": "right_erling",
  "name": "恩山无线论坛（erling 签到）",
  "homepage": "https://www.right.com.cn/forum/",
  "version": "1.0.0",
  "updated": "2026-11-08",
  "mission_url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:sign_in",
  "need_browser": false,
  "verify_ssl": true,
  "flow": [
    { "action": "get", "url": "{mission_url}" },
    { "action": "extract_regex", "pattern": "var FORMHASH = '([0-9a-f]+)'", "save_as": "formhash", "required": true },
    { "action": "post", "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:action&action=sign", "data": { "formhash": "{formhash}" } }
  ],
  "success_keywords": ["签到成功", "\"success\":true", "\"success\": true"],
  "fail_keywords": ["\"success\":false", "\"success\": false", "您需要先登录", "登录后才能使用签到功能", "请先登录", "需要登录"],
  "already_keywords": ["已签到", "今天已经", "重复签到", "已领取"],
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36 Edg/125.0.0.0",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9",
    "Referer": "https://www.right.com.cn/forum/",
    "X-Requested-With": "XMLHttpRequest"
  },
  "note": "恩山无线论坛 erling 签到插件。Discuz 论坛的 formhash 与登录会话绑定：先 GET 签到页取 formhash，再带它 POST 签到。需粘贴登录 Cookie；若实际还要求 u_atoken/u_asig，请改用浏览器录制。"
}
